[Unit]
Description=Sleep Log Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=sleeplog
WorkingDirectory=/opt/sleep-log
ExecStart=/opt/sleep-log/.venv/bin/python -m sleep_log.bot
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sleep-log
PrivateTmp=true

[Install]
WantedBy=multi-user.target
